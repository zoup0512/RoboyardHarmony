import { util } from '@kit.ArkTS';
import { hilog } from '@kit.PerformanceAnalysisKit';
import { AppContext } from '../common/AppContext';
import { Constants } from '../common/Constants';
import { LevelData, parseLevel } from './Level';

const TAG = 'LevelRepository';

/**
 * Loads the built-in levels from rawfile/Maps/level_N.txt and the precomputed optimal
 * move counts from rawfile/optimal_moves.json (generated by tools/compute_optimal_moves.js).
 */
export class LevelRepository {
  private static optimalMoves: number[] | null = null;

  private static readRawText(path: string): string {
    const bytes: Uint8Array = AppContext.get().resourceManager.getRawFileContentSync(path);
    const decoder = util.TextDecoder.create('utf-8', { ignoreBOM: true });
    return decoder.decodeToString(bytes);
  }

  static levelCount(): number {
    return Constants.LEVEL_COUNT;
  }

  static loadLevel(levelId: number): LevelData {
    return parseLevel(levelId, LevelRepository.readRawText(`Maps/level_${levelId}.txt`));
  }

  /** Optimal number of moves for a level, or -1 if unknown. */
  static getOptimalMoves(levelId: number): number {
    if (LevelRepository.optimalMoves === null) {
      try {
        LevelRepository.optimalMoves = JSON.parse(LevelRepository.readRawText('optimal_moves.json')) as number[];
      } catch (e) {
        hilog.error(0x0000, TAG, 'Failed to load optimal_moves.json: %{public}s', JSON.stringify(e));
        LevelRepository.optimalMoves = [];
      }
    }
    const table = LevelRepository.optimalMoves;
    if (levelId < 1 || levelId > table.length) {
      return -1;
    }
    return table[levelId - 1];
  }
}
